-- ============================================================
-- ALL 22 COUNTRIES — PER-LEVER breakdown of the MULTI-OFFENDER (2+ reasons)
-- method, country grain + GLOBAL. Per-lever counterpart to
-- dt60_query_ALL_COUNTRIES_combined_removal_6lever_p90_p95_multioffender_ROLLING30D.sql
-- -- same rolling 30-day window (CURRENT_DATE()-based, no manual date
-- editing needed on re-run), same 6-lever set (dropoff_distance
-- included), same corrected rr_pct logic, same 2+ reasons bar. Use the
-- combined/union query for "what's the country-level target," use this
-- one for "which lever is driving it."
--
-- METHODOLOGY NOTE: P90/P95 thresholds are recomputed on this rolling
-- 30-day window only (per country) -- a recent-performance snapshot, not
-- directly comparable number-for-number to a year-to-date run.
--
-- Date range: DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) through
-- DATE_ADD(CURRENT_DATE(), INTERVAL 1 DAY) exclusive.
-- ============================================================

CREATE TEMP TABLE order_level_ext_allcountries_6lv2_r30d AS (
  WITH orders_base AS (
    SELECT
      o.global_order_id AS order_id,
      LOWER(o.country_code) AS country_code,
      CASE
        WHEN LOWER(o.country_code) = 'gv-it' THEN DATE(o.order_created_at, "Europe/Rome")
        ELSE DATE(o.order_created_at)
      END AS local_day,
      CASE
        WHEN (
          CASE
            WHEN o.is_preorder = TRUE
              THEN TIMESTAMP_DIFF(TIMESTAMP(o.rider_dropped_off_at), TIMESTAMP(o.order_queued_at), MINUTE)
            ELSE (o.actual_delivery_time_in_seconds + COALESCE(o.at_customer_time_in_seconds, 0)) / 60.00
          END > 60
        ) AND o.vertical_type = 'restaurants' THEN 1
        ELSE 0
      END AS is_dt60,
      o.pickup_distance_flight_in_meters AS PickUpDistance,
      o.dropoff_distance_flight_in_meters AS DropOffDistance
    FROM `fulfillment-dwh-production.curated_data_shared_glovo.logistics_orders__orders` AS o
    WHERE DATE(o.order_created_at) >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)
      AND DATE(o.order_created_at) <  DATE_ADD(CURRENT_DATE(), INTERVAL 1 DAY)
      AND LOWER(o.country_code) IN (
        'gv-am','gv-ba','gv-bg','gv-ci','gv-es','gv-ge','gv-hr','gv-it','gv-ke','gv-kg',
        'gv-kz','gv-ma','gv-md','gv-me','gv-ng','gv-pl','gv-pt','gv-ro','gv-rs','gv-tn',
        'gv-ua','gv-ug'
      )
      AND o.order_status = 'completed'
      AND o.vertical_type = 'restaurants'
  ),
  dt_glovo AS (
    SELECT
      TRIM(CAST(o.global_order_id AS STRING)) AS join_key,
      LOWER(o.country_code) AS country_code,
      CASE
        WHEN o.is_preorder = TRUE
          THEN TIMESTAMP_DIFF(TIMESTAMP(o.rider_dropped_off_at), TIMESTAMP(t.order_queued_at), MINUTE)
        ELSE (o.actual_delivery_time_in_seconds + COALESCE(t.at_customer_time_in_seconds, 0)) / 60.0
      END AS total_delivery_time_minutes
    FROM `fulfillment-dwh-production.curated_data_shared_glovo.logistics_orders__deliveries` o
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_glovo.logistics_orders__order_times` t
      ON t.order_id = o.order_id AND t.country_code = o.country_code
    WHERE o.is_primary = TRUE
      AND o.delivery_status = 'completed'
      AND o.p_creation_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)
      AND o.p_creation_date <  DATE_ADD(CURRENT_DATE(), INTERVAL 1 DAY)
      AND LOWER(o.country_code) IN (
        'gv-am','gv-ba','gv-bg','gv-ci','gv-es','gv-ge','gv-hr','gv-it','gv-ke','gv-kg',
        'gv-kz','gv-ma','gv-md','gv-me','gv-ng','gv-pl','gv-pt','gv-ro','gv-rs','gv-tn',
        'gv-ua','gv-ug'
      )
  ),
  northstar_combined AS (
    SELECT
      TRIM(CAST(v.order_id AS STRING)) AS join_key,
      LOWER(v.country_code) AS ns_country_2letter,
      v.dispatch_to_pickup_time_minutes,
      v.wait_time_pickup_minutes AS at_vendor_time_minutes,
      v.to_customer_time_minutes
    FROM `fulfillment-dwh-production.curated_data_shared_glovo.vendor_northstar_metrics_order_level_join__order_level_northstar_metrics_join` AS v
    WHERE v.region IS NOT NULL
      AND v.p_created_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)
      AND v.p_created_date <  DATE_ADD(CURRENT_DATE(), INTERVAL 1 DAY)
      AND LOWER(v.country_code) IN (
        'am','ba','bg','ci','es','ge','hr','it','ke','kg','kz','ma','md','me','ng',
        'pl','pt','ro','rs','tn','ua','ug'
      )
  ),
  transitions AS (
    SELECT
      o.global_order_id AS order_id,
      LOWER(o.country_code) AS country_code,
      del.id AS delivery_id,
      tr.state,
      LEAD(tr.state) OVER (PARTITION BY o.country_code, del.id ORDER BY tr.created_at ASC) AS next_state
    FROM `fulfillment-dwh-production.curated_data_shared.orders` AS o
    LEFT JOIN UNNEST(deliveries) AS del
    LEFT JOIN UNNEST(del.transitions) AS tr
    WHERE created_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)
      AND created_date <  DATE_ADD(CURRENT_DATE(), INTERVAL 1 DAY)
      AND LOWER(o.country_code) IN (
        'gv-am','gv-ba','gv-bg','gv-ci','gv-es','gv-ge','gv-hr','gv-it','gv-ke','gv-kg',
        'gv-kz','gv-ma','gv-md','gv-me','gv-ng','gv-pl','gv-pt','gv-ro','gv-rs','gv-tn',
        'gv-ua','gv-ug'
      )
      AND tr.state IN ('cancelled', 'scheduled', 'queued', 'dispatched', 'courier_notified')
  ),
  reassignments AS (
    SELECT
      order_id,
      country_code,
      COUNT(delivery_id) AS total_couriers_notified,
      COUNTIF(next_state IN ('queued', 'dispatched')) AS total_reassignments
    FROM transitions
    WHERE state = 'courier_notified'
    GROUP BY order_id, country_code
  )
  SELECT
    b.order_id,
    b.country_code,
    EXTRACT(YEAR FROM b.local_day) AS order_year,
    b.is_dt60 AS ISDT60,
    dg.total_delivery_time_minutes AS delivery_time,
    b.PickUpDistance,
    b.DropOffDistance,
    SAFE_DIVIDE(r.total_reassignments, NULLIF(r.total_couriers_notified, 0)) * 100.0 AS RR_pct,
    nc.dispatch_to_pickup_time_minutes,
    nc.at_vendor_time_minutes AS waiting_time_at_dropoff,
    CASE
      WHEN b.DropOffDistance >= 100
        THEN SAFE_DIVIDE(nc.to_customer_time_minutes, b.DropOffDistance / 1000.0)
      ELSE NULL
    END AS speed_pace
  FROM orders_base AS b
  LEFT JOIN dt_glovo AS dg ON dg.join_key = CAST(b.order_id AS STRING) AND dg.country_code = b.country_code
  LEFT JOIN reassignments AS r ON r.order_id = CAST(b.order_id AS STRING) AND r.country_code = b.country_code
  LEFT JOIN northstar_combined AS nc
    ON nc.join_key = CAST(b.order_id AS STRING)
   AND nc.ns_country_2letter = REPLACE(b.country_code, 'gv-', '')
);

CREATE TEMP TABLE lever_long_allcountries_6lv2_r30d AS (
  SELECT e.country_code, e.order_year, e.ISDT60, lever.lever_name, lever.lever_value
  FROM order_level_ext_allcountries_6lv2_r30d e,
  UNNEST([
    STRUCT('dispatch_to_pu' AS lever_name, IF(e.dispatch_to_pickup_time_minutes >= 0, e.dispatch_to_pickup_time_minutes, NULL) AS lever_value),
    STRUCT('waiting_at_dropoff', IF(e.waiting_time_at_dropoff >= 0, e.waiting_time_at_dropoff, NULL)),
    STRUCT('sp_distance', IF(e.PickUpDistance >= 0, e.PickUpDistance, NULL)),
    STRUCT('dropoff_distance', IF(e.DropOffDistance >= 0, e.DropOffDistance, NULL)),
    STRUCT('speed_pace', IF(e.speed_pace >= 0, e.speed_pace, NULL)),
    STRUCT('rr_pct', IF(e.RR_pct >= 0, e.RR_pct, NULL))
  ]) AS lever
);

CREATE TEMP TABLE thresholds_by_country_year_r30d AS (
  SELECT
    country_code, order_year,
    MAX(IF(lever_name = 'dispatch_to_pu',     p90, NULL)) AS p90_dispatch_to_pu,
    MAX(IF(lever_name = 'waiting_at_dropoff', p90, NULL)) AS p90_waiting_at_dropoff,
    MAX(IF(lever_name = 'sp_distance',        p90, NULL)) AS p90_sp_distance,
    MAX(IF(lever_name = 'dropoff_distance',   p90, NULL)) AS p90_dropoff_distance,
    MAX(IF(lever_name = 'speed_pace',         p90, NULL)) AS p90_speed_pace,
    MAX(IF(lever_name = 'rr_pct',             p90, NULL)) AS p90_rr_pct,
    MAX(IF(lever_name = 'dispatch_to_pu',     p95, NULL)) AS p95_dispatch_to_pu,
    MAX(IF(lever_name = 'waiting_at_dropoff', p95, NULL)) AS p95_waiting_at_dropoff,
    MAX(IF(lever_name = 'sp_distance',        p95, NULL)) AS p95_sp_distance,
    MAX(IF(lever_name = 'dropoff_distance',   p95, NULL)) AS p95_dropoff_distance,
    MAX(IF(lever_name = 'speed_pace',         p95, NULL)) AS p95_speed_pace,
    MAX(IF(lever_name = 'rr_pct',             p95, NULL)) AS p95_rr_pct
  FROM (
    SELECT
      country_code, order_year, lever_name,
      APPROX_QUANTILES(lever_value, 100)[OFFSET(90)] AS p90,
      APPROX_QUANTILES(lever_value, 100)[OFFSET(95)] AS p95
    FROM lever_long_allcountries_6lv2_r30d
    WHERE lever_value IS NOT NULL
    GROUP BY country_code, order_year, lever_name
  )
  GROUP BY country_code, order_year
);

WITH order_flags AS (
  SELECT
    e.country_code, e.order_year, e.ISDT60,

    (e.dispatch_to_pickup_time_minutes IS NOT NULL AND e.dispatch_to_pickup_time_minutes >= 0 AND e.dispatch_to_pickup_time_minutes > t.p90_dispatch_to_pu) AS p90_dispatch_to_pu,
    (e.waiting_time_at_dropoff        IS NOT NULL AND e.waiting_time_at_dropoff        >= 0 AND e.waiting_time_at_dropoff        > t.p90_waiting_at_dropoff) AS p90_waiting_at_dropoff,
    (e.PickUpDistance                 IS NOT NULL AND e.PickUpDistance                 >= 0 AND e.PickUpDistance                 > t.p90_sp_distance) AS p90_sp_distance,
    (e.DropOffDistance                IS NOT NULL AND e.DropOffDistance                >= 0 AND e.DropOffDistance                > t.p90_dropoff_distance) AS p90_dropoff_distance,
    (e.speed_pace                     IS NOT NULL AND e.speed_pace                     >= 0 AND e.speed_pace                     > t.p90_speed_pace) AS p90_speed_pace,
    (e.RR_pct                          IS NOT NULL AND e.RR_pct                         >= 0 AND e.RR_pct                          > t.p90_rr_pct) AS p90_rr_pct,

    (e.dispatch_to_pickup_time_minutes IS NOT NULL AND e.dispatch_to_pickup_time_minutes >= 0 AND e.dispatch_to_pickup_time_minutes > t.p95_dispatch_to_pu) AS p95_dispatch_to_pu,
    (e.waiting_time_at_dropoff        IS NOT NULL AND e.waiting_time_at_dropoff        >= 0 AND e.waiting_time_at_dropoff        > t.p95_waiting_at_dropoff) AS p95_waiting_at_dropoff,
    (e.PickUpDistance                 IS NOT NULL AND e.PickUpDistance                 >= 0 AND e.PickUpDistance                 > t.p95_sp_distance) AS p95_sp_distance,
    (e.DropOffDistance                IS NOT NULL AND e.DropOffDistance                >= 0 AND e.DropOffDistance                > t.p95_dropoff_distance) AS p95_dropoff_distance,
    (e.speed_pace                     IS NOT NULL AND e.speed_pace                     >= 0 AND e.speed_pace                     > t.p95_speed_pace) AS p95_speed_pace,
    (e.RR_pct                          IS NOT NULL AND e.RR_pct                         >= 0 AND e.RR_pct                          > t.p95_rr_pct) AS p95_rr_pct

  FROM order_level_ext_allcountries_6lv2_r30d e
  LEFT JOIN thresholds_by_country_year_r30d t ON t.country_code = e.country_code AND t.order_year = e.order_year
),

order_flags_with_counts AS (
  SELECT
    *,
    (IF(p90_dispatch_to_pu,1,0)+IF(p90_waiting_at_dropoff,1,0)+IF(p90_sp_distance,1,0)+IF(p90_dropoff_distance,1,0)+IF(p90_speed_pace,1,0)+IF(p90_rr_pct,1,0)) AS n_reasons_p90,
    (IF(p95_dispatch_to_pu,1,0)+IF(p95_waiting_at_dropoff,1,0)+IF(p95_sp_distance,1,0)+IF(p95_dropoff_distance,1,0)+IF(p95_speed_pace,1,0)+IF(p95_rr_pct,1,0)) AS n_reasons_p95
  FROM order_flags
),

lever_long_multi AS (
  SELECT country_code, order_year, ISDT60, lever.lever_name,
    lever.in_tail AND (n_reasons_p90 >= 2) AS in_tail_as_multi_p90,
    lever.in_tail95 AND (n_reasons_p95 >= 2) AS in_tail_as_multi_p95
  FROM order_flags_with_counts,
  UNNEST([
    STRUCT('dispatch_to_pu' AS lever_name, p90_dispatch_to_pu AS in_tail, p95_dispatch_to_pu AS in_tail95),
    STRUCT('waiting_at_dropoff', p90_waiting_at_dropoff, p95_waiting_at_dropoff),
    STRUCT('sp_distance', p90_sp_distance, p95_sp_distance),
    STRUCT('dropoff_distance', p90_dropoff_distance, p95_dropoff_distance),
    STRUCT('speed_pace', p90_speed_pace, p95_speed_pace),
    STRUCT('rr_pct', p90_rr_pct, p95_rr_pct)
  ]) AS lever
),

country_year_totals AS (
  SELECT country_code, order_year, COUNT(*) AS total_orders,
    SAFE_DIVIDE(COUNTIF(ISDT60 = 1), COUNT(*)) * 100.0 AS dt60_overall_pct
  FROM order_level_ext_allcountries_6lv2_r30d
  GROUP BY country_code, order_year
),

global_totals AS (
  SELECT order_year, COUNT(*) AS total_orders,
    SAFE_DIVIDE(COUNTIF(ISDT60 = 1), COUNT(*)) * 100.0 AS dt60_overall_pct
  FROM order_level_ext_allcountries_6lv2_r30d
  GROUP BY order_year
),

per_lever_country AS (
  SELECT
    country_code, order_year, lever_name,
    COUNT(*) AS n_orders,

    COUNTIF(in_tail_as_multi_p90) AS n_orders_in_tail_p90,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p90), COUNT(*)) * 100.0 AS pct_orders_in_tail_p90,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p90 AND ISDT60 = 1), NULLIF(COUNTIF(in_tail_as_multi_p90), 0)) * 100.0 AS dt60_in_tail_p90_pct,
    SAFE_DIVIDE(COUNTIF(NOT in_tail_as_multi_p90 AND ISDT60 = 1), NULLIF(COUNTIF(NOT in_tail_as_multi_p90), 0)) * 100.0 AS dt60_if_lever_fixed_p90_pct,

    COUNTIF(in_tail_as_multi_p95) AS n_orders_in_tail_p95,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p95), COUNT(*)) * 100.0 AS pct_orders_in_tail_p95,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p95 AND ISDT60 = 1), NULLIF(COUNTIF(in_tail_as_multi_p95), 0)) * 100.0 AS dt60_in_tail_p95_pct,
    SAFE_DIVIDE(COUNTIF(NOT in_tail_as_multi_p95 AND ISDT60 = 1), NULLIF(COUNTIF(NOT in_tail_as_multi_p95), 0)) * 100.0 AS dt60_if_lever_fixed_p95_pct
  FROM lever_long_multi
  GROUP BY country_code, order_year, lever_name
),

per_lever_global AS (
  SELECT
    'GLOBAL' AS country_code, order_year, lever_name,
    COUNT(*) AS n_orders,

    COUNTIF(in_tail_as_multi_p90) AS n_orders_in_tail_p90,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p90), COUNT(*)) * 100.0 AS pct_orders_in_tail_p90,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p90 AND ISDT60 = 1), NULLIF(COUNTIF(in_tail_as_multi_p90), 0)) * 100.0 AS dt60_in_tail_p90_pct,
    SAFE_DIVIDE(COUNTIF(NOT in_tail_as_multi_p90 AND ISDT60 = 1), NULLIF(COUNTIF(NOT in_tail_as_multi_p90), 0)) * 100.0 AS dt60_if_lever_fixed_p90_pct,

    COUNTIF(in_tail_as_multi_p95) AS n_orders_in_tail_p95,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p95), COUNT(*)) * 100.0 AS pct_orders_in_tail_p95,
    SAFE_DIVIDE(COUNTIF(in_tail_as_multi_p95 AND ISDT60 = 1), NULLIF(COUNTIF(in_tail_as_multi_p95), 0)) * 100.0 AS dt60_in_tail_p95_pct,
    SAFE_DIVIDE(COUNTIF(NOT in_tail_as_multi_p95 AND ISDT60 = 1), NULLIF(COUNTIF(NOT in_tail_as_multi_p95), 0)) * 100.0 AS dt60_if_lever_fixed_p95_pct
  FROM lever_long_multi
  GROUP BY order_year, lever_name
)

SELECT
  pl.country_code, pl.order_year, pl.lever_name,
  t.total_orders, t.dt60_overall_pct,
  pl.pct_orders_in_tail_p90, pl.n_orders_in_tail_p90, pl.dt60_in_tail_p90_pct, pl.dt60_if_lever_fixed_p90_pct,
  t.dt60_overall_pct - pl.dt60_if_lever_fixed_p90_pct AS improvement_potential_p90_pp,
  pl.pct_orders_in_tail_p95, pl.n_orders_in_tail_p95, pl.dt60_in_tail_p95_pct, pl.dt60_if_lever_fixed_p95_pct,
  t.dt60_overall_pct - pl.dt60_if_lever_fixed_p95_pct AS improvement_potential_p95_pp
FROM per_lever_country pl
JOIN country_year_totals t ON t.country_code = pl.country_code AND t.order_year = pl.order_year

UNION ALL

SELECT
  pg.country_code, pg.order_year, pg.lever_name,
  g.total_orders, g.dt60_overall_pct,
  pg.pct_orders_in_tail_p90, pg.n_orders_in_tail_p90, pg.dt60_in_tail_p90_pct, pg.dt60_if_lever_fixed_p90_pct,
  g.dt60_overall_pct - pg.dt60_if_lever_fixed_p90_pct AS improvement_potential_p90_pp,
  pg.pct_orders_in_tail_p95, pg.n_orders_in_tail_p95, pg.dt60_in_tail_p95_pct, pg.dt60_if_lever_fixed_p95_pct,
  g.dt60_overall_pct - pg.dt60_if_lever_fixed_p95_pct AS improvement_potential_p95_pp
FROM per_lever_global pg
JOIN global_totals g ON g.order_year = pg.order_year

ORDER BY country_code, order_year, lever_name;
